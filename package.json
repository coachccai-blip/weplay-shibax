{
  "name": "weplay-shibax",
  "version": "1.0.0",
  "private": true,
  "description": "Weplay Shibax : chat entre amis et mini-jeux (Draw It), sur Netlify Functions et Netlify Blobs.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "netlify dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:api": "node tests/api/run.mjs",
    "test:e2e": "node tests/e2e/drawit.e2e.mjs",
    "check:words": "node scripts/check-words.mjs",
    "zip": "bash scripts/make-zip.sh"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.9",
    "@preact/signals": "2.11.4",
    "htm": "3.1.1",
    "preact": "10.29.8",
    "uqr": "0.1.3",
    "vite": "8.3.8"
  }
}
